generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-project"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_PROJECT_URL")
}

model Project {
  id       String   @id @default(cuid())
  name     String
  position String
  repoLink String?
  date     DateTime @default(now())
  progress Int      @default(0)
  decision String   @default("pending")
  finished Boolean  @default(false)

  imageDescription  String?
  imageDescription2 String?
  imageUrl          String?
  moduleUrl         String?

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@unique([name, userId])
  @@index([userId])
  @@index([decision])
  @@index([createdAt])
}

model Attachment {
  id                      Int      @id @default(autoincrement())
  projectId               String
  type                    String
  name                    String
  url                     String
  status                  String   @default("pending")
  description             String?
  isAdditionalDescription Boolean? @default(false)
  createdAt               DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}
