generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/prisma-monitoring"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_MONITORING_URL")
}

// ============================================
// REVISION REPORT MODEL
// Relasi ke User di auth_db dijaga manual
// (sentById, targetUserId = String biasa)
// ============================================
model RevisionReport {
  id             String   @id @default(cuid())
  projectName    String
  issueType      String   @default("MODUL")
  description    String?  @db.Text
  progress       String   @default("BELUM_DILAKUKAN")
  approval       String   @default("PENDING")
  approvalNote   String?  @db.Text
  senderRole     String
  targetRole     String
  targetUserId   String?
  sentById       String?
  attachmentName String?
  attachmentUrl  String?
  attachmentData String?  @db.LongText
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments RevisionComment[]

  @@index([targetRole])
  @@index([senderRole])
  @@index([approval])
  @@index([createdAt])
  @@index([targetUserId])
  @@index([sentById])
}

// ============================================
// REVISION COMMENT MODEL
// Relasi ke User di auth_db dijaga manual
// (authorId = String biasa)
// ============================================
model RevisionComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  reportId  String
  createdAt DateTime @default(now())

  report RevisionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([authorId])
}

// ============================================
// NOTIFICATION MODEL
// Relasi ke User di auth_db dijaga manual
// (userId = String biasa)
// ============================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("system")
  link      String?
  isRead    Boolean  @default(false)
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}
