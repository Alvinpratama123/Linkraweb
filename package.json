{
  "name": "linkraweb",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:gateway": "npm --prefix gateway run dev",
    "dev:auth": "npm --prefix services/auth run dev",
    "dev:project": "npm --prefix services/project run dev",
    "dev:revision": "npm --prefix services/revision run dev",
    "dev:notification": "npm --prefix services/notification run dev",
    "dev:file": "npm --prefix services/file run dev",
    "dev:email": "npm --prefix services/email run dev",
    "dev:dashboard": "npm --prefix services/dashboard run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "next dev",
    "build": "bash scripts/build-all.sh",
    "db:generate": "npm --prefix services/auth run db:generate && npm --prefix services/project run db:generate && npm --prefix services/notification run db:generate",
    "db:push": "npm --prefix services/auth run db:push && npm --prefix services/project run db:push && npm --prefix services/notification run db:push",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "multer": "^2.2.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "sweetalert2": "^11.26.25",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.3.2"
  }
}
