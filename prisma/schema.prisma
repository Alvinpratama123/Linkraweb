generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("MEMBER")
  position  String?
  profile   String?
  photo     String?

  isVerified Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  registerOtps    RegisterOtp[]
  sentRevisions   RevisionReport[] @relation("SentBy")
  revisionComments RevisionComment[]
}

model RegisterOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([email])
  @@index([code])
}


model Project {
  id          Int          @id @default(autoincrement())
  name        String
  position    String
  repoLink    String?
  date        String
  progress    Int          @default(0)
  decision    String       @default("pending")
  finished    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  attachments Attachment[]

  @@unique([name, position])
}

model Attachment {
  id          Int      @id @default(autoincrement())
  projectId   Int
  type        String   // "image", "module", "link"
  name        String
  url         String
  status      String   @default("pending") // "pending", "approved", "rejected"
  description String?
  isAdditionalDescription Boolean? @default(false)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RevisionReport {
  id             String   @id @default(cuid())
  projectName    String
  issueType      String   @default("MODUL")
  description    String?  @db.Text        // ← hapus @default(""), jadikan nullable
  progress       String   @default("BELUM_DILAKUKAN")
  approval       String   @default("PENDING")
  approvalNote   String?  @db.Text

  senderRole     String
  targetRole     String

  sentById       String?
  sentBy         User?    @relation("SentBy", fields: [sentById], references: [id])

  attachmentName String?
  attachmentUrl  String?
  attachmentData String?  @db.LongText

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments       RevisionComment[]

  @@index([targetRole])
  @@index([senderRole])
  @@index([approval])
  @@index([createdAt])
}

model RevisionComment {
  id        String         @id @default(cuid())
  content   String         @db.Text
  authorId  String
  reportId  String

  author    User           @relation(fields: [authorId], references: [id])
  report    RevisionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime       @default(now())

  @@index([reportId])
}