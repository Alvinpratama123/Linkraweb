  registerOtps     RegisterOtp[]
  passwordResets   PasswordResetToken[]
  revisionComments RevisionComment[]
  sentRevisions    RevisionReport[]  @relation("SentBy")
  targetRevisions  RevisionReport[]  @relation("TargetUser") // 🔥 TAMBAHKAN INI
  projects         Project[]
