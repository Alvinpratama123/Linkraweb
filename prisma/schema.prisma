// ============================================
// NOTIFICATION MODEL
// ============================================
model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String   @db.Text
  type        String   @default("system")
  link        String?
  isRead      Boolean  @default(false)
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}

// ============================================
// REGISTER OTP MODEL
// ============================================
model RegisterOtp {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([code])
  @@index([used])
}

// ============================================
// PASSWORD RESET TOKEN MODEL
// ============================================
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([email])
  @@index([code])
  @@index([used])
  @@index([userId])
}

// ============================================
// PROJECT MODEL
// ============================================
model Project {
  id          String   @id @default(cuid())
  name        String
  position    String
  repoLink    String?
  date        DateTime @default(now())
  progress    Int      @default(0)
  decision    String   @default("pending")
  finished    Boolean  @default(false)
  
  imageDescription  String?
  imageDescription2 String?
  imageUrl          String?
  moduleUrl         String?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments Attachment[]

  @@unique([name, userId])
  @@index([userId])
  @@index([decision])
  @@index([createdAt])
}

// ============================================
// ATTACHMENT MODEL
// ============================================
model Attachment {
  id                      Int      @id @default(autoincrement())
  projectId               String
  type                    String
  name                    String
  url                     String
  status                  String   @default("pending")
  description             String?
  isAdditionalDescription Boolean? @default(false)
  createdAt               DateTime @default(now())

  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ============================================
// REVISION REPORT MODEL
// ============================================
model RevisionReport {
  id             String            @id @default(cuid())
  projectName    String
  issueType      String            @default("MODUL")
  description    String?           @db.Text
  progress       String            @default("BELUM_DILAKUKAN")
  approval       String            @default("PENDING")
  approvalNote   String?           @db.Text
  senderRole     String
  targetRole     String
  targetUserId   String?           // 🔥 TAMBAHKAN INI - ID user tujuan
  sentById       String?
  attachmentName String?
  attachmentUrl  String?
  attachmentData String?           @db.LongText
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  comments       RevisionComment[]
  sentBy         User?             @relation("SentBy", fields: [sentById], references: [id], onDelete: SetNull)
  targetUser     User?             @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull) // 🔥 TAMBAHKAN INI

  @@index([targetRole])
  @@index([senderRole])
  @@index([approval])
  @@index([createdAt])
  @@index([targetUserId]) // 🔥 TAMBAHKAN INDEX
}

// ============================================
// REVISION COMMENT MODEL
// ============================================
model RevisionComment {
  id        String         @id @default(cuid())
  content   String         @db.Text
  authorId  String
  reportId  String
  createdAt DateTime       @default(now())

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  report    RevisionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([authorId])
}

// ============================================
// NOTIFICATION MODEL
// ============================================
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String?
  type      String    @default("system")
  link      String?
  icon      String?
  color     String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
