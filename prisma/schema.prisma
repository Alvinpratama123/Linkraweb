generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  role                String               @default("member")
  photo               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isVerified          Boolean              @default(true)
  position            String?
  profile             String?
  credentialEmailSent Boolean              @default(false)
  notifications       Notification[]
  passwordResets      PasswordResetToken[]
  projects            Project[]
  registerOtps        RegisterOtp[]
  revisionComments    RevisionComment[]
  sentRevisions       RevisionReport[]     @relation("SentBy")

  @@index([email])
  @@index([role])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("system")
  link      String?
  isRead    Boolean  @default(false)
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}

model RegisterOtp {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([code])
  @@index([used])
  @@index([userId], map: "RegisterOtp_userId_fkey")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([code])
  @@index([used])
  @@index([userId])
}

model Project {
  id                String       @id @default(cuid())
  name              String
  position          String
  repoLink          String?
  date              DateTime     @default(now())
  progress          Int          @default(0)
  decision          String       @default("pending")
  finished          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  imageDescription  String?
  imageDescription2 String?
  imageUrl          String?
  moduleUrl         String?
  userId            String
  attachments       Attachment[]
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  @@index([userId])
  @@index([decision])
  @@index([createdAt])
}

model Attachment {
  id                      Int      @id @default(autoincrement())
  projectId               String
  type                    String
  name                    String
  url                     String
  status                  String   @default("pending")
  createdAt               DateTime @default(now())
  description             String?
  isAdditionalDescription Boolean? @default(false)
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model RevisionReport {
  id             String            @id @default(cuid())
  projectName    String
  issueType      String            @default("MODUL")
  description    String?           @db.Text
  progress       String            @default("BELUM_DILAKUKAN")
  approval       String            @default("PENDING")
  approvalNote   String?           @db.Text
  senderRole     String
  targetRole     String
  sentById       String?
  attachmentName String?
  attachmentUrl  String?
  attachmentData String?           @db.LongText
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  comments       RevisionComment[]
  sentBy         User?             @relation("SentBy", fields: [sentById], references: [id])

  @@index([targetRole])
  @@index([senderRole])
  @@index([approval])
  @@index([createdAt])
  @@index([sentById], map: "RevisionReport_sentById_fkey")
}

model RevisionComment {
  id        String         @id @default(cuid())
  content   String         @db.Text
  authorId  String
  reportId  String
  createdAt DateTime       @default(now())
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  report    RevisionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([authorId])
}
