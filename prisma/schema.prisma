generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  name             String
  role             String            @default("MEMBER")
  photo            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isVerified       Boolean           @default(false)
  position         String?
  profile          String?
  registerOtps     RegisterOtp[]
  revisionComments RevisionComment[]
  sentRevisions    RevisionReport[]  @relation("SentBy")
}

model RegisterOtp {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([code])
  @@index([userId], map: "RegisterOtp_userId_fkey")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([code])
}

model Project {
  id          Int          @id @default(autoincrement())
  name        String
  position    String
  repoLink    String?
  date        String
  progress    Int          @default(0)
  decision    String       @default("pending")
  finished    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  @@unique([name, position])
}

model Attachment {
  id                      Int      @id @default(autoincrement())
  projectId               Int
  type                    String
  name                    String
  url                     String
  status                  String   @default("pending")
  createdAt               DateTime @default(now())
  description             String?
  isAdditionalDescription Boolean? @default(false)
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RevisionReport {
  id             String            @id @default(cuid())
  projectName    String
  issueType      String            @default("MODUL")
  description    String?           @db.Text
  progress       String            @default("BELUM_DILAKUKAN")
  approval       String            @default("PENDING")
  approvalNote   String?           @db.Text
  senderRole     String
  targetRole     String
  sentById       String?
  attachmentName String?
  attachmentUrl  String?
  attachmentData String?           @db.LongText
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  comments       RevisionComment[]
  sentBy         User?             @relation("SentBy", fields: [sentById], references: [id])

  @@index([targetRole])
  @@index([senderRole])
  @@index([approval])
  @@index([createdAt])
  @@index([sentById], map: "RevisionReport_sentById_fkey")
}

model RevisionComment {
  id        String         @id @default(cuid())
  content   String         @db.Text
  authorId  String
  reportId  String
  createdAt DateTime       @default(now())
  author    User           @relation(fields: [authorId], references: [id])
  report    RevisionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([authorId], map: "RevisionComment_authorId_fkey")
}
