generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("USER")
  photo     String?   
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())  // ✅ Tambah @default(now())
  
  loginTokens LoginToken[]
}

model LoginToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   // ✅ Diubah dari Int ke String (cocok dengan User.id)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}