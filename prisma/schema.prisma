generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("MEMBER")  // ADMIN, MEMBER (ubah dari USER ke MEMBER)
  position  String?   // Frontend, Backend, Fullstack, UI/UX, DevOps, QA, PM
  profile   String?   // Link profile/github/portfolio
  photo     String?   
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  loginTokens LoginToken[]
}

model LoginToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int          @id @default(autoincrement())
  name        String
  position    String
  repoLink    String?
  date        String
  progress    Int          @default(0)
  decision    String       @default("pending")
  finished    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  attachments Attachment[]
}

model Attachment {
  id        Int      @id @default(autoincrement())
  projectId Int
  type      String   // image, module, link
  name      String
  url       String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}